# Copy to .env and adjust for your machine. docker compose reads it automatically.

# Database
POSTGRES_DB=tasknow_db
POSTGRES_USER=tasknow_user
POSTGRES_PASSWORD=tasknow_password

# Django
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-key-do-not-use-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
